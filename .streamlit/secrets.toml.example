# Copiá este archivo a .streamlit/secrets.toml (local) o pegalo en
# Streamlit Community Cloud → App settings → Secrets. Nunca lo subas al repo.

# Clave HMAC para firmar credenciales y QR de clase (generala con:
#   python -c "import secrets; print(secrets.token_hex(32))")
SIA_SECRET = "reemplazar-por-una-clave-larga-y-aleatoria"

# Si se define, el registro de docentes exige este código de alta.
SIA_DOCENTE_CODE = "codigo-institucional"

# Opcionales
SIA_TZ = "America/Argentina/Buenos_Aires"
SIA_SESSION_MINUTES = "30"

# URL pública de la app (ej. https://sia-ise.streamlit.app). Si se define, los QR de inscripción
# y de asistencia son enlaces reales que funcionan con la cámara nativa del celular.
# Si no se define, se detecta automáticamente desde el navegador (excepto en localhost).
# SIA_PUBLIC_URL = "https://sia-ise.streamlit.app"
